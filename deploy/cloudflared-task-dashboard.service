[Unit]
Description=Quick tunnel for Task Dashboard
Wants=network-online.target task-dashboard.service
After=network-online.target task-dashboard.service

[Service]
Type=simple
User=collector
ExecStart=/home/collector/.local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8788
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
